[Unit]
Description=Chocolate Pi -- Setlist Admin (web UI for the library USB and WiFi)
# install_setlist_admin.sh deliberately does NOT `systemctl enable` this
# unit -- setlist-network-watchdog.service starts and stops it directly
# based on whether there's a usable IP (SETLIST_ADMIN_SPECIFICATION.md
# section 5, step 4). Running with no network at all would just be a
# listening server no one can reach, wasting the RAM/CPU section 7 is
# explicit about not spending. The [Install] section below only matters
# if someone deliberately runs `systemctl enable` on this by hand.
After=network.target

[Service]
Type=simple
# Same placeholder convention as pedal-core.service -- replace before
# installing.
User=<YOUR_USER>
# Never contends for CPU with pedal-core.service -- playback wins,
# always (section 7). This is a companion tool, not the live-critical
# path.
Nice=10
CPUWeight=20
ExecStart=/usr/bin/python3 /home/<YOUR_USER>/chocolatepi/expansions/setlist-admin-wifi/src/admin/server.py --usb-root /media/usb --usb-uuid=<YOUR_USB_UUID> --port 8080 --log-file /home/<YOUR_USER>/setlist-admin.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
